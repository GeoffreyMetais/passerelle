# ==============================================================================
# Configuration Passerelle — Copier ce fichier vers deploy/.env avant lancement
# cp deploy/.env.example deploy/.env
# ==============================================================================

# --- Ports exposés sur l'hôte (derrière votre reverse-proxy TLS) ---
API_PORT=8080
WEB_PORT=3000

# --- Répertoire local monté en LECTURE SEULE (:ro) dans /data ---
# Exemple NAS : /mnt/nas/partages
HOST_DATA_DIR=./sample-data

# --- Domaine & Sous-dossiers configurables ---
# Pour un hébergement sur un domaine unique en deux sous-dossiers :
#   PWA Web : https://partage.exemple.fr/passerelle
#   API & liens publics : https://partage.exemple.fr/passerelle-api
# Pour un déploiement à la racine (sans sous-dossier), laissez WEB_BASE_PATH= et API_BASE_PATH= vides.
APP_SCHEME=https
APP_DOMAIN=partage.exemple.fr
WEB_BASE_PATH=/passerelle
API_BASE_PATH=/passerelle-api

# URL publique du backend Rust (liens courts + API) — sans slash final
PUBLIC_BASE_URL=${APP_SCHEME}://${APP_DOMAIN}${API_BASE_PATH}

# Origines CORS autorisées (séparées par des virgules, sans chemin ni slash final)
ALLOWED_ORIGINS=${APP_SCHEME}://${APP_DOMAIN}

# --- Sécurité & Administrateur ---
ADMIN_USERNAME=admin
# Changer impérativement ce mot de passe avant toute mise en production
ADMIN_PASSWORD=changez-moi-mot-de-passe-robuste
# Secret JWT HMAC-SHA256 (minimum 16 caractères aléatoires ; ex: openssl rand -hex 32)
JWT_SECRET=remplacez-ce-secret-jwt-par-une-cle-aleatoire-32-chars

# --- Limites & Observabilité ---
# Taille maximale cumulée d'un dossier téléchargé en ZIP64 (défaut : 10 Gio = 10737418240)
MAX_ZIP_SIZE_BYTES=10737418240
RUST_LOG=info
