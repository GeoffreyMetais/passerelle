# ==============================================================================
# Passerelle configuration — Copy this file to deploy/.env before starting
# cp deploy/.env.example deploy/.env
# ==============================================================================

# --- Ports exposed on the host (behind your TLS reverse proxy) ---
API_PORT=8080
WEB_PORT=3000

# --- Local directory mounted READ-ONLY (:ro) into /data ---
# NAS example: /mnt/nas/shares
HOST_DATA_DIR=./sample-data

# --- Domain & configurable subdirectories ---
# For hosting on a single domain in two subdirectories:
#   Web PWA: https://partage.exemple.fr/passerelle
#   API & public links: https://partage.exemple.fr/passerelle-api
# For a root deployment (no subdirectory), leave WEB_BASE_PATH= and API_BASE_PATH= empty.
APP_SCHEME=https
APP_DOMAIN=partage.exemple.fr
WEB_BASE_PATH=/passerelle
API_BASE_PATH=/passerelle-api

# Public URL of the Rust backend (short links + API) — no trailing slash
PUBLIC_BASE_URL=${APP_SCHEME}://${APP_DOMAIN}${API_BASE_PATH}

# Allowed CORS origins (comma-separated, no path and no trailing slash)
ALLOWED_ORIGINS=${APP_SCHEME}://${APP_DOMAIN}

# --- Security & Administrator ---
ADMIN_USERNAME=admin
# You must change this password before any production deployment
ADMIN_PASSWORD=changez-moi-mot-de-passe-robuste
# JWT HMAC-SHA256 secret (minimum 16 random characters; e.g. openssl rand -hex 32)
JWT_SECRET=remplacez-ce-secret-jwt-par-une-cle-aleatoire-32-chars

# --- Limits & Observability ---
# Maximum cumulative size of a folder downloaded as ZIP64 (default: 10 GiB = 10737418240)
MAX_ZIP_SIZE_BYTES=10737418240
RUST_LOG=info
